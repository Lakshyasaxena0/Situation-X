{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Feedback",
  "type": "object",
  "required": [
    "id",
    "analysis_id",
    "user_id",
    "rating",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "analysis_id": {
      "type": "string",
      "format": "uuid"
    },
    "user_id": {
      "type": "string",
      "format": "uuid"
    },
    "rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "comment": {
      "type": ["string", "null"],
      "maxLength": 1000
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
